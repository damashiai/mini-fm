NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=anon-key-here
SUPABASE_SERVICE_ROLE_KEY=service-role-key-here
# MusicBrainz needs no credentials (keyless API + Cover Art Archive).
# Just be a good citizen: the client already sends a descriptive User-Agent
# and throttles to ~1 req/sec.
ENABLE_WRITE_OPERATIONS=true
CRON_SECRET=local-dev-secret
# AI Gateway: automatic via OIDC on Vercel deploys. For local dev, run
# `vercel link` + `vercel env pull`, or set AI_GATEWAY_API_KEY.
# AI_GATEWAY_API_KEY=
